name: Build Android APK Only

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Build App Code
        run: |
          npm install --legacy-peer-deps
          npm run build

      - name: Setup Capacitor & Sync Android
        run: |
          npm install @capacitor/core @capacitor/cli @capacitor/android --legacy-peer-deps
          npx cap init "Pulsar PRO" "com.pulsar.app" --web-dir dist
          npx cap add android
          npx cap sync android

      - uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Generate APK File
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Output Downloadable APK
        uses: actions/upload-artifact@v4
        with:
          name: PulsarPRO-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk

